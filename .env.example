# Gemini API key (https://aistudio.google.com/apikey). Leave unset to use the
# built-in mock storyteller, which needs no network access.
GEMINI_API_KEY=

# Force a provider: "gemini" or "mock". Defaults to gemini when a key is set.
# AI_PROVIDER=

# Model overrides (the image model is only used with SKETCHES=generate)
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Sketches: "library" (default, free: the model picks from the hand-drawn set in
# public/sketches/), "generate" (an image model draws each one; paid, needs
# billing), or "off".
# SKETCHES=library

# Where stories are kept: "file" (default, writes to .data/) or "memory".
# STORY_STORE=file

# Generate the pages behind each choice while the reader is still reading.
# PREFETCH_CHOICES=true

# Reading aloud: "on" (default) lets readers tap the speaker to hear each page.
# A page is recorded (streamed as it is spoken) only when someone listens, about
# $0.02 a page, then kept for later listeners.
# NARRATION=on
# GEMINI_SPEECH_MODEL=gemini-3.8-flash-tts

# Show each story's running cost on its cover (logged on the server either way).
# SHOW_COSTS=true
